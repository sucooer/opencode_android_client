<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext HTTP is permitted for all domains.
    Modified to allow direct IP connection (e.g. 186.x.x.x).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
